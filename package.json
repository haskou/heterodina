{
  "name": "heterodina",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "server": "node --watch server/main.ts",
    "web": "vite",
    "build": "npm run typecheck && vite build",
    "start": "node server/main.ts",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json",
    "test": "node --test \"server/**/*.test.ts\" \"shared/**/*.test.ts\" \"web/src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "kuromoji": "^0.1.2",
    "mpg123-decoder": "^1.0.3",
    "wanakana": "^5.3.1"
  }
}
